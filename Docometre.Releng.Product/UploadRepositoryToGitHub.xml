<project name="Deploy Docometre App" default="deploy" basedir=".">
	<!-- Properties -->
	<property name="github.owner" value="fbuloup"/>
	<property name="github.repo" value="docometre-release"/>
	<property name="release.tag" value="docometre"/>
	<property name="product.dir" location="./target"/>
	<property name="p2.dir" location="${product.dir}/repository"/>
	<property name="gh.pages.branch" value="gh-pages"/>
	<property name="gh.pages.branch.new" value="gh-pages-new"/>
	<property file="github.properties"/>

	<!-- ZIP locations -->
	<property name="zip.mac" location="${product.dir}/DocometreProduct-linux.gtk.x86_64.zip"/>
	<property name="zip.linux" location="${product.dir}/DocometreProduct-linux.gtk.x86_64.zip"/>
	<property name="zip.win" location="${product.dir}/DocometreProduct-win32.win32.x86_64.zip"/>

	<condition property="isMac">
		<os family="mac" />
	</condition>

	<condition property="linux.present">
		<available file="./target/products/DocometreProduct-linux.gtk.x86_64.zip" />
	</condition>

	<condition property="mac.present">
		<available file="./target/products/DocometreProduct-macosx.cocoa.x86_64.zip" />
	</condition>

	<condition property="windows.present">
		<available file="./target/products/DocometreProduct-win32.win32.x86_64.zip" />
	</condition>

	<echoproperties>
	</echoproperties>

	<!-- Buid dmg file (mac only!) -->
	<target name="A1_BuildDMGFile" if="isMac">
		<delete file="target/products/DOCoMETRe.dmg" />
		<exec executable="hdiutil" failonerror="true">
			<arg line="create -srcfolder 'target/products/DocometreProduct/macosx/cocoa/x86_64' -volname 'DOCoMETRe' -fs HFS+ -fsargs '-c c=64,a=16,e=16' -format UDRO 'target/products/DOCoMETRe.dmg'" />
		</exec>
	</target>

	<!-- Get dmg file (if not mac!) -->
	<target name="A2_GetDMGFile" unless="isMac">
		<get src="https://github.com/fbuloup/docometre-release/releases/download/docometre/DOCoMETRe.dmg" dest="./target/products/DOCoMETRe.dmg" usetimestamp="true" verbose="true" />
	</target>

	<target name="A3_MoveLinuxFile" if="linux.present">
		<move file="./target/products/DocometreProduct-linux.gtk.x86_64.zip" tofile="target/products/DocometreLinux.zip"/>
	</target>

	<target name="A4_MoveMacFiles" if="mac.present">
		<move file="target/products/DocometreProduct-macosx.cocoa.x86_64.zip" tofile="target/products/DocometreMacOS.zip"/>
	</target>

	<target name="A5_MoveWindowsFiles" if="windows.present">
		<move file="target/products/DocometreProduct-win32.win32.x86_64.zip" tofile="target/products/DocometreWindows.zip"/>
	</target>

	<!-- Delete actual release -->
	<target name="B1_delete-releases">
		<exec executable="gh" failonerror="true">
			<env key="GITHUB_TOKEN" value="${GH_TOKEN}"/>
			<arg value="release"/>
			<arg value="delete"/>
			<arg value="${release.tag}"/>
			<arg value="--repo"/>
			<arg value="${github.owner}/${github.repo}"/>
		</exec>
	</target>


	<!-- Create new release and upload ZIP and DMG files -->
	<target name="C1_upload-releases">
		<!-- Crée une release via GitHub CLI -->
		<exec executable="gh" failonerror="true">
			<env key="GITHUB_TOKEN" value="${GH_TOKEN}"/>
			<arg value="release"/>
			<arg value="create"/>
			<arg value="${release.tag}"/>
			<arg value="${product.dir}/products/*.zip"/>
			<arg value="${product.dir}/products/DOCoMETRe.dmg"/>
			<arg value="--repo"/>
			<arg value="${github.owner}/${github.repo}"/>
		</exec>
	</target>

	<!-- Deploy p2 repo to GitHub Pages -->
	<target name="C2_deploy-p2">
		<!-- Clone gh-pages branch to gh-pages-temp folder -->
		<exec executable="git" failonerror="true">
			<arg value="clone"/>
			<arg value="--branch"/>
			<arg value="${gh.pages.branch}"/>
			<arg value="https://github.com/${github.owner}/${github.repo}.git"/>
			<arg value="gh-pages-temp"/>
		</exec>
		<!-- Switch gh-pages-new branch : branch without history -->
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="checkout"/>
			<arg value="--orphan"/>
			<arg value="${gh.pages.branch.new}"/>
		</exec>
		<!-- Copy p2 folder to gh-pages-temp/p2 folder -->
		<copy todir="gh-pages-temp/p2" overwrite="true">
			<fileset dir="${p2.dir}"/>
		</copy>
		<!-- Commit and push changes to gh-pages-new branch -->
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="add"/>
			<arg value="p2/"/>
		</exec>
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="config"/>
			<arg value="user.name"/>
			<arg value="GitHub Actions"/>
		</exec>
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="config"/>
			<arg value="user.email"/>
			<arg value="actions@github.com"/>
		</exec>
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="commit"/>
			<arg value="-m"/>
			<arg value="Deploy p2 repository for ${release.tag} - Flat history"/>
		</exec>
		<exec executable="git" dir="gh-pages-temp" failonerror="true">
			<arg value="push"/>
			<arg value="origin"/>
			<arg value="${gh.pages.branch.new}:${gh.pages.branch}"/>
			<arg value="--force"/>
		</exec>
	</target>

	<target name="C3_Delete-zip-assets">
		<exec executable="gh" failonerror="true">
			<env key="GITHUB_TOKEN" value="${GH_TOKEN}"/>
			<arg value="release"/>
			<arg value="delete-asset"/>
			<arg value="${release.tag}"/>
			<arg value="Source code (zip)"/>
			<arg value="--repo"/>
			<arg value="${github.owner}/${github.repo}"/>
		</exec>
	</target>

	<target name="D1_Delete-gh-pages-temp">
		<!-- Nettoie le dossier temporaire -->
		<delete dir="gh-pages-temp" verbose="true"/>
	</target>

	<!-- Cible principale -->
	<target name="deploy" depends="A1_BuildDMGFile, A2_GetDMGFile, A3_MoveLinuxFile, A4_MoveMacFiles, A5_MoveWindowsFiles, B1_delete-releases, C1_upload-releases, C2_deploy-p2, D1_Delete-gh-pages-temp">
		<echo>Déploiement terminé avec succès !</echo>
	</target>
</project>