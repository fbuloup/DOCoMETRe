		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/technology/babel/update-site/R0.20.0/2022-12/"/>
			<unit id="org.eclipse.core.resources.nl_fr" version="4.26.0.v20230220105658"/>
		</location>
		<!-- Eclipse 2025-03 : bundles propres a Linux (gtk, x86_64) et macOS (cocoa, x86_64), les autres
		     environnements du produit (pom.xml). Mode "slicer" + tous les environnements : le mode "planner"
		     ne retient que les bundles de l'environnement courant. Liste calculee depuis les features incluses
		     par Docometre.feature, comme Tycho (le meme calcul redonne les 6 bundles Windows de bundles.info). -->
		<location includeAllPlatforms="true" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/releases/2025-03/"/>
			<!-- Linux gtk x86_64 -->
			<unit id="org.eclipse.e4.ui.swt.gtk" version="1.2.200.v20240416-0658"/>
			<unit id="org.eclipse.equinox.launcher.gtk.linux.x86_64" version="1.2.1300.v20250212-0927"/>
			<unit id="org.eclipse.equinox.security.linux" version="1.1.300.v20240419-2334"/>
			<unit id="org.eclipse.swt.gtk.linux.x86_64" version="3.129.0.v20250221-1734"/>
			<!-- macOS cocoa x86_64 -->
			<unit id="org.eclipse.e4.ui.workbench.renderers.swt.cocoa" version="0.14.400.v20240525-0701"/>
			<unit id="org.eclipse.equinox.launcher.cocoa.macosx.x86_64" version="1.2.1200.v20250212-0927"/>
			<unit id="org.eclipse.equinox.security.macosx" version="1.102.400.v20250130-0533"/>
			<unit id="org.eclipse.swt.cocoa.macosx.x86_64" version="3.129.0.v20250221-1734"/>
			<unit id="org.eclipse.ui.cocoa" version="1.3.200.v20240309-0857"/>
		</location>
	</locations>
	<environment>
